# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Where the SQLite database and uploaded evidence live.
# Defaults to server/data and server/uploads.
# DATA_DIR=./server/data
# UPLOAD_DIR=./server/uploads

# First-run administrator (only used while the workspace has no accounts)
# BOOTSTRAP_ADMIN_USERNAME=bbox5259
# BOOTSTRAP_ADMIN_PASSWORD=Mxcoradm@5259
# BOOTSTRAP_ADMIN_EMAIL=bbox5259@sentinel.local
# BOOTSTRAP_ADMIN_NAME=Workspace Administrator

# Session lifetime in days (default 7)
# SESSION_DAYS=7

# Set to true when serving over HTTPS so the session cookie is marked Secure
# COOKIE_SECURE=true
